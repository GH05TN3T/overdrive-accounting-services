{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "overdrive-accounting-services",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "overdrive",
      "database_id": "36cee0a4-cbdc-4f0f-9269-3c68edb0def1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "overdrive"
    }
  ],
  "vars": {
    "ADMIN_EMAILS": "Info@OverdriveAccountingServices.com"
  }
}
